#include <iostream>
#include <string>
using namespace std;

int main() {
    string name[5] = {"Rohan", "Amit", "Neha", "Priya", "Karan"};

    for (int i = 0; i < 5 - 1; i++) {
        for (int j = 0; j < 5 - i - 1; j++) {
            if (name[j] > name[j + 1]) {
                string temp = name[j];
                name[j] = name[j + 1];
                name[j + 1] = temp;
            }
        }
    }

    cout << "Names in alphabetical order:\n";
    for (int i = 0; i < 5; i++)
        cout << name[i] << endl;

    return 0;
}
