#include <iostream>
using namespace std;

int main() {
    int a[5] = {12, 24, 36, 48, 60};
    int key, found = 0;

    cout << "Enter number: ";
    cin >> key;

    for (int i = 0; i < 5; i++) {
        if (a[i] == key) {
            found = 1;
            break;
        }
    }

    if (found == 1)
        cout << "Number is present";
    else
        cout << "Number is not present";

    return 0;
}
